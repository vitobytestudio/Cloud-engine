{
  "name": "OpenHands — الحاسوب السحابي",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/setup-openhands.sh",
  "postStartCommand": "bash .devcontainer/start-openhands.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "OpenHands", "onAutoForward": "openBrowser", "visibility": "public" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["OPENHANDS.md"] }
  }
}
