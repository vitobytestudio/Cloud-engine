    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "esbuild": "^0.27.0",
    "jsdom": "^31.0.0",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  }
}
